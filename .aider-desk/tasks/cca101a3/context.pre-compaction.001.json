            "type": "text",
            "value": "1|from docx import Document\n2|import sys\n3|\n4|# Simple CLI tool to extract text from a DOCX file and print to stdout\n5|\n6|def extract_text_from_docx(path: str) -> str:\n7|    try:\n8|        doc = Document(path)\n9|    except Exception as e:\n10|        raise SystemExit(f\"Error reading DOCX file: {e}\")\n11|    lines = []\n12|    for para in doc.paragraphs:\n13|        text = (para.text or \"\").strip()\n14|        if text:\n15|            lines.append(text)\n16|    return \"\\n\".join(lines)\n17|\n18|\n19|def main():\n20|    if len(sys.argv) < 2:\n21|        print(\"Usage: python extract_docx_text.py <path_to_docx>\")\n22|        sys.exit(1)\n23|    path = sys.argv[1]\n24|    text = extract_text_from_docx(path)\n25|    # Write output to utf-8 file to avoid encoding issues\n26|    with open(\"materials.txt\", \"w\", encoding=\"utf-8\") as f:\n27|        f.write(text)\n28|    print(\"DONE_WRITE\")\n29|\n30|if __name__ == \"__main__\":\n31|    main()\n32|"
